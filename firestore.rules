rules_version = '2';

// Each user can read and write only their own library documents:
//   users/{uid}/library/{favorites|watchlist}
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/library/{list} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && list in ['favorites', 'watchlist']
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is map
        // Guards the 1 MiB document limit; ~5k titles per list.
        && request.resource.data.items.size() <= 5000;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
