# TMDB API v3 base URL
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3

# TMDB v4 "API Read Access Token" (a JWT), sent as: Authorization: Bearer <token>
# Create one at https://www.themoviedb.org/settings/api
#
# NOTE: Vite inlines every VITE_-prefixed variable into the client bundle at
# build time, so this token is public once deployed. Use a read-only token and
# rotate it if it leaks. To keep it truly secret, proxy TMDB through a backend.
VITE_TMDB_ACCESS_TOKEN=

# Firebase Analytics (GA4). From Firebase console → Project settings → Your apps
# → Web app → SDK setup and configuration. These are public identifiers, not
# secrets. Leave them blank to disable analytics entirely.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Collection defaults to ON in production builds and OFF in `npm run dev`.
# Set to true/false to override.
VITE_ANALYTICS_ENABLED=
# true = log every event to the console and send it to GA4 DebugView.
VITE_ANALYTICS_DEBUG=
